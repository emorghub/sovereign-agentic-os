# Sovereign Agentic OS — lakehouse Compose deployment (deploy/lakehouse-compose).
#
#   cp deploy/lakehouse-compose/.env.example deploy/lakehouse-compose/.env
#
# This file is used INSTEAD of the repo-root .env (via --env-file), so this
# deployment never reads or changes your existing stack's settings.
# Every value below is a LOCAL-DEV PLACEHOLDER (same style as the root .env.example).
# Replace each *-local-dev / change-me value before exposing this anywhere.
#
# Note: the repo .gitignore matches `.env.*`, so this template is ignored by git
# unless force-added (the root .env.example is tracked the same way).

# ---- Compose -------------------------------------------------------------------
# Profiles for the BASE services. pg-rw, minio and minio-bucket-init always run in
# this deployment (the lakehouse needs them) regardless of this list.
COMPOSE_PROFILES=mock,postgres-local,litellm-local,langfuse-local

# ---- Host ports (remapped so this stack can run next to the default one) --------
LH_OS_UI_PORT=13000
LH_FORGEJO_PORT=13001
LH_LANGFUSE_PORT=13002
LH_LITELLM_PORT=14000
LH_CUBE_PORT=14040
LH_AGENT_RUNTIME_PORT=18000
LH_TRINO_PORT=18080
LH_OPA_PORT=18181
LH_OPENMETADATA_PORT=18585

# ---- Lakehouse (new) -------------------------------------------------------------
# Polaris realm root principal (chart: polaris.local.rootClientId/rootClientSecret).
# Trino and data-runner authenticate to the catalog with this OAuth2 client.
POLARIS_REALM=default-realm
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=polaris-local-dev-change-me
# Polaris JDBC metastore role in pg-rw (created by polaris-db-init).
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=polaris-local-dev-change-me
# Shared bearer os-ui presents to query-tool + data-runner (chart: serviceBearer).
SERVICE_BEARER_TOKEN=service-bearer-local-dev-change-me
# Cube API secret (chart: cube.local.apiSecret).
CUBE_API_SECRET=cube-local-dev-change-me
# OpenMetadata metastore role in pg-rw (created by openmetadata-db-init).
OM_DB_USER=openmetadata
OM_DB_PASSWORD=openmetadata-local-dev-change-me
# OpenMetadata Fernet key: the PUBLIC default shipped in the upstream chart's
# values.yaml (openmetadata.config.fernetkey). Generate your own for real use:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OM_FERNET_KEY=jJ/9sz0g0OHxsfxOoSfdFdmk3ysNmPRnH3TUAbz3IHA=

# ---- os-ui -------------------------------------------------------------------------
# `data` (and `files`, `metrics`) must be enabled for the medallion workflow.
OS_ENABLED_TABS=home,about,agents,monitoring,llm-gateway,mcp,governance,tutorials,admin,components,data,files,metrics
OS_SESSION_SECRET=os-session-secret-local-dev-change-me
OS_USERS=[{"id":"admin","name":"Admin","email":"admin@datamasterclass.com","password":"admin","domains":["platform"],"role":"admin"}]
OS_UI_AGENT_RUNTIME_URL=http://agent-runtime:8000
OS_UI_FORGEJO_URL=http://forgejo-http:3000
OS_UI_LITELLM_URL=http://agentic-os-litellm:4000
OS_UI_OPA_URL=http://opa:8181
OS_UI_LANGFUSE_URL=http://agentic-os-langfuse-web:3000

# ---- Postgres / object storage (shared with the base services) ----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local-dev
POSTGRES_DB=postgres
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse-local-dev
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=litellm-local-dev
S3_ACCESS_KEY=agentic-os-local
S3_SECRET_KEY=agentic-os-local-secret

# ---- LiteLLM / models (offline mock by default; see compose/README.md) --------------
PROXY_MASTER_KEY=sk-litellm-local-dev-master
LITELLM_AGENT_KEY=sk-agents-local-dev
LITELLM_CONFIG=config.mock.yaml
LITELLM_CHAT_MODEL=sovereign-mock
LITELLM_REASONING_MODEL=sovereign-reasoning
LITELLM_EXEC_MODEL=sovereign-default
AGENT_RUNTIME_CHAT_MODEL=sovereign-mock
AGENT_RUNTIME_REASONING_MODEL=sovereign-reasoning
AGENT_RUNTIME_EXECUTION_MODEL=sovereign-default
AGENT_RUNTIME_LITELLM_BASE_URL=http://agentic-os-litellm:4000/v1
AGENT_RUNTIME_GOVERNED_TOOL_URL=http://os-ui:3000/api/agents/tool
AGENT_RUNTIME_TOKEN=agent-runtime-local-dev-token

# ---- Forgejo ---------------------------------------------------------------------------
FORGEJO_DOMAIN=forgejo-http
FORGEJO_ROOT_URL=http://forgejo-http:3000/
FORGEJO_ADMIN_USER=gitea_admin
FORGEJO_ADMIN_PASSWORD=forgejo-admin-local-dev
FORGEJO_ADMIN_EMAIL=admin@datamasterclass.com

# ---- Langfuse ----------------------------------------------------------------------------
CLICKHOUSE_PASSWORD=clickhouse-local-dev
VALKEY_PASSWORD=valkey-local-dev
LANGFUSE_SALT=sovereign-os-local-dev-salt
LANGFUSE_NEXTAUTH_SECRET=sovereign-os-local-dev-nextauth-secret
LANGFUSE_ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
LANGFUSE_NEXTAUTH_URL=http://localhost:13002
LANGFUSE_INIT_USER_EMAIL=alex@datamasterclass.com
LANGFUSE_INIT_USER_NAME=Alex
LANGFUSE_INIT_USER_PASSWORD=langfuse-local-dev-admin
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-localdev0000public
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-localdev0000secret
LITELLM_LANGFUSE_HOST=http://agentic-os-langfuse-web:3000
