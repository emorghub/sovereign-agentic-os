#
# os-ui — local development against a REAL cluster.
#
# Copy to `.env.local` (gitignored) and edit:   cp .env.example .env.local
#
# Every variable below already has a default in lib/core/config.ts — but every
# default is an in-cluster Kubernetes Service name, which does not resolve from a
# laptop. That is the only reason this file exists: it re-points each backend at a
# `kubectl port-forward` on localhost.
#
# Ports follow the 1xxxx scheme from INTEGRATION.md so nothing collides with
# `npm run dev`, which itself binds 3000.
#
# ---------------------------------------------------------------------------
# Open the tunnels first (one shell, backgrounded):
#
#   kubectl -n agentic-os port-forward svc/opensearch                  19200:9200 &
#   kubectl -n agentic-os port-forward svc/agentic-os-litellm          14000:4000 &
#   kubectl -n agentic-os port-forward svc/query-tool                  18000:8000 &
#   kubectl -n agentic-os port-forward svc/opa                         18181:8181 &
#   kubectl -n agentic-os port-forward svc/sample-agent                18001:8000 &
#   kubectl -n agentic-os port-forward svc/agentic-os-langfuse-web     13000:3000 &
#   kubectl -n agentic-os port-forward svc/forgejo-http                19300:3000 &
#   kubectl -n agentic-os port-forward svc/agentic-os-dagster-webserver 13070:80 &
#
# Read a credential out of the cluster with:
#   kubectl -n agentic-os get secret <name> -o go-template='{{ .data.<KEY> | base64decode }}'
# ---------------------------------------------------------------------------


# === Required — the UI is broken or silently wrong without these ============

# All OS state: users, files, apps, datasets. Also the identity store.
OPENSEARCH_URL=http://127.0.0.1:19200

# Model gateway — every AI call in the product goes through it.
LITELLM_URL=http://127.0.0.1:14000
# Secret litellm-credentials, key masterkey
LITELLM_MASTER_KEY=sk-litellm-REPLACE-ME

# Lakehouse SQL behind the Data tab.
QUERY_TOOL_URL=http://127.0.0.1:18000

# Policy engine. NOTE: authorization FAILS CLOSED — if OPA is unreachable every
# governed data/metric action is denied, so this is not optional in practice.
# (OPA_FAIL_OPEN=true exists for the offline teaching flow only. Never in a cluster.)
OPA_URL=http://127.0.0.1:18181


# === Core =================================================================

# Default chat model. The built-in default 'sovereign-mock' returns canned text,
# so set this to a real routed model or the UI looks broken in a subtle way.
LITELLM_CHAT_MODEL=sovereign-default

# LEAVE EMPTY for local dev. The cluster's value scopes the session cookie to the
# public hostname; carrying it over to localhost means login returns 200 and then
# silently bounces you back to /signin.
OS_PUBLIC_URL=


# === Backends — set the ones whose tabs you are working on =================

# Agent core: the Home health probe and /ask.
SAMPLE_AGENT_URL=http://127.0.0.1:18001

# Traces behind Monitoring. Cluster port is 3000; forwarded to 13000 to avoid
# colliding with `npm run dev`.
LANGFUSE_URL=http://127.0.0.1:13000
# Plain chart value (langfuseInit.publicKey) — not a Secret.
LANGFUSE_PUBLIC_KEY=pk-lf-localdev0000public
# Secret langfuse-init, key LANGFUSE_INIT_PROJECT_SECRET_KEY
LANGFUSE_SECRET_KEY=sk-lf-REPLACE-ME

# Object storage for Files and uploads.
S3_ENDPOINT=http://127.0.0.1:19000
# Secret object-storage-credentials. Empty values mean uploads fail.
AWS_ACCESS_KEY_ID=REPLACE-ME
AWS_SECRET_ACCESS_KEY=REPLACE-ME

# Git backend for the Software tab.
FORGEJO_URL=http://127.0.0.1:19300
# Secret forgejo-admin, key password. User is gitea_admin.
FORGEJO_PASSWORD=REPLACE-ME

# Runs built agent systems.
AGENT_RUNTIME_URL=http://127.0.0.1:18002
# Secret agent-runtime-token, key token
AGENT_RUNTIME_TOKEN=REPLACE-ME

# Orchestration health probe + GraphQL.
DAGSTER_URL=http://127.0.0.1:13070

# Dataset ingest / transform jobs behind the Data tab.
DATA_RUNNER_URL=http://127.0.0.1:18003


# === Optional ==============================================================

# Semantic layer behind Metrics and Dashboards.
CUBE_URL=http://127.0.0.1:14001

# PDF / document parsing on file upload.
DOCLING_URL=http://127.0.0.1:15001
